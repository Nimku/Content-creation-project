# ============================================================
#  ALL SETTINGS LIVE HERE.
#  Copy this file to ".env" and fill in your own values:
#     cp .env.example .env
#     nano .env
#  Lines starting with # are comments and are ignored.
# ============================================================

# ---- API keys ----
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
TELEGRAM_BOT_TOKEN=
# Your own Telegram user ID (a number). Only you can use the bot.
# Get it by messaging @userinfobot on Telegram.
TELEGRAM_ADMIN_ID=

# ---- AI models ----
# Must be a Gemini 3.x Flash model (NOT 2.5, it is being shut down).
GEMINI_MODEL=gemini-3.8-flash
# Backup model, used only if the main one is too busy (also must be 3.x)
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
# How many video frames per second Gemini looks at (higher = catches quick taps, costs more)
GEMINI_FPS=2
DEEPSEEK_MODEL=deepseek-chat

# ---- Estimated prices (US dollars per 1 million tokens), used for the cost log ----
GEMINI_PRICE_INPUT=0.75
GEMINI_PRICE_OUTPUT=3.75
DEEPSEEK_PRICE_INPUT=0.28
DEEPSEEK_PRICE_OUTPUT=0.42

# ---- Your channel ----
CHANNEL_NAME=@asianproxy

# ---- Languages (comma separated). Codes: en, id, vi, th, ms ----
LANGUAGES=en,id,vi,th,ms

# ---- Voices (one per language, from: edge-tts --list-voices) ----
VOICE_EN=en-US-AriaNeural
VOICE_ID=id-ID-GadisNeural
VOICE_VI=vi-VN-HoaiMyNeural
VOICE_TH=th-TH-PremwadeeNeural
VOICE_MS=ms-MY-YasminNeural

# Speaking speed: +0% is normal, +10% a bit faster, -10% slower
VOICE_RATE=+10%

# ---- Look ----
ARROW_COLOR=#FF3B30
SUBTITLE_COLOR=#FFFFFF
HIGHLIGHT_COLOR=#FFD60A
STEP_LABEL_COLOR=#0A84FF

# How much to zoom in on each tap (1.0 = no zoom)
ZOOM=1.35

# ---- Housekeeping ----
# CPU threads for making videos. Keep low so your proxies stay fast.
RENDER_THREADS=2
# Delete temporary files older than this many days
CLEANUP_DAYS=3
